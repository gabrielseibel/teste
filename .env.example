# ============================================================================
# VERIFICA — Golpes & Notícias — variáveis de ambiente
# ============================================================================
# Copie este arquivo para ".env.local" (nunca faça commit do .env.local).
#
# O VERIFICA não tem backend próprio: é um site 100% estático (export do
# Next.js) e todo o motor de análise roda no navegador de quem usa — 100%
# determinístico, sem nenhuma chamada a IA generativa em nenhum lugar do
# sistema. Toda análise compara o conteúdo enviado pela pessoa contra uma
# base de conhecimento conhecida (catálogo de táticas de golpe, domínios
# oficiais, alegações já verificadas).
#
# O app funciona SEM nenhuma variável configurada: nesse modo, usa uma base
# de conhecimento estática, embutida no código (services/knowledge/staticData.ts).
# Configurar o Supabase abaixo é opcional — ele permite manter essa base em
# um banco de dados real, editável sem precisar alterar código ou redeployar.
#
# Importante: como não há servidor, as variáveis precisam do prefixo
# NEXT_PUBLIC_ para o Next.js incluí-las no código enviado ao navegador.
# ============================================================================

# --- Supabase (opcional) --------------------------------------------------
# URL e chave pública ("anon"/"publishable") do seu projeto Supabase. Essas
# chaves são seguras para expor no navegador: o acesso de leitura é público
# por design (Row Level Security permite apenas SELECT em registros ativos)
# e não há nenhuma escrita exposta ao app. Nunca use a "service_role key" aqui.
#
# Como obter: crie um projeto gratuito em https://supabase.com, rode as
# migrations em supabase/migrations/ (SQL Editor do painel, em ordem), e
# copie a URL e a chave pública em Project Settings > API.
#
# O build de produção publicado no GitHub Pages já vem com um projeto
# Supabase configurado (ver .env.production, versionado no repositório —
# os valores ali também são públicos por design). Preencha os campos abaixo
# apenas se quiser rodar contra o seu próprio projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OCR (extração de texto de imagens) ----------------------------------
# Defina como "false" para desativar o OCR (por exemplo, para reduzir o
# tamanho do bundle nessa implantação). O OCR roda no navegador (WASM, via
# tesseract.js) — a imagem nunca é enviada a nenhum servidor; apenas o texto
# extraído dela entra na análise.
NEXT_PUBLIC_OCR_ENABLED=true
