# ============================================================================
# VERIFICA — Golpes & Notícias — variáveis de ambiente
# ============================================================================
# Copie este arquivo para ".env.local" (nunca faça commit do .env.local).
#
# O motor de análise do VERIFICA é 100% determinístico — não há nenhuma
# chamada a IA generativa em nenhum lugar do sistema. Toda análise compara o
# conteúdo enviado pelo usuário contra uma base de conhecimento conhecida
# (catálogo de táticas de golpe, domínios oficiais, alegações já verificadas).
#
# O app funciona SEM nenhuma variável configurada: nesse modo, usa uma base
# de conhecimento estática, embutida no código (services/knowledge/staticData.ts).
# Configurar o Supabase abaixo é opcional — ele permite manter essa base em
# um banco de dados real, editável sem precisar alterar código ou redeployar.
# ============================================================================

# --- Supabase (opcional) --------------------------------------------------
# URL e chave pública ("anon"/"publishable") do seu projeto Supabase. Essas
# chaves são seguras para uso no backend: o acesso de leitura é público por
# design (Row Level Security permite apenas SELECT em registros ativos) e
# não há nenhuma escrita exposta ao app. Nunca use a "service_role key" aqui.
#
# Como obter: crie um projeto gratuito em https://supabase.com, rode as
# migrations em supabase/migrations/ (SQL Editor do painel, em ordem), e
# copie a URL e a "anon key" em Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- OCR (extração de texto de imagens) ----------------------------------
# Defina como "false" para desativar o OCR mesmo que a dependência opcional
# "tesseract.js" esteja instalada (por exemplo, em ambientes sem acesso à
# internet para baixar os dados do modelo de idioma na primeira execução).
# O OCR roda localmente (WASM) — não é um serviço de IA generativa nem envia
# dados a terceiros.
OCR_ENABLED=true
