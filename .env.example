# ============================================================================
# VERIFICA — Golpes & Notícias — variáveis de ambiente
# ============================================================================
# Copie este arquivo para ".env.local" (nunca faça commit do .env.local) e
# preencha apenas o que for usar. O sistema funciona SEM nenhuma chave
# configurada: nesse modo, ele usa uma análise determinística baseada em
# catálogo de padrões conhecidos (sem IA generativa e sem busca externa),
# nunca simulando uma resposta de IA que não existe.
#
# Nenhuma dessas chaves deve ser exposta ao frontend — todas são lidas
# apenas no backend (rotas em src/app/api/**).
# ============================================================================

# --- Provedor de IA -----------------------------------------------------
# Escolha "anthropic" ou "openai". Se omitido, o sistema usa automaticamente
# o primeiro provedor cuja chave estiver definida abaixo.
AI_PROVIDER=anthropic

# Chave da API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Chave da API OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Pesquisa na internet (fact-checking) --------------------------------
# Usada apenas no Modo 2 ("Essa notícia é verdade?") para localizar fontes
# públicas independentes. Sem esta chave, o sistema nunca inventa fontes —
# ele classifica honestamente como "não confirmada" quando não há como
# verificar. Adapter de referência: Brave Search API
# (https://api.search.brave.com/).
BRAVE_SEARCH_API_KEY=

# --- OCR (extração de texto de imagens) ----------------------------------
# Defina como "false" para desativar o OCR mesmo que a dependência opcional
# "tesseract.js" esteja instalada (por exemplo, em ambientes sem acesso à
# internet para baixar os dados do modelo de idioma na primeira execução).
OCR_ENABLED=true
